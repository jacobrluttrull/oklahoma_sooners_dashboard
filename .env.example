# Django Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to git!

# Django Secret Key (required in production)
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=your-secret-key-here

# Debug Mode (set to False in production)
# Default: True
# DEBUG=False

# Allowed Hosts (comma-separated list of domains)
# Example: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Default: localhost,127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1

# College Football Data API Token (required)
# Get your API key from: https://collegefootballdata.com/key
BEARER_TOKEN=your-cfbd-api-token-here

# Optional: Default Season Configuration
# SEASON_YEAR=2025
# DEFAULT_TEAM=Oklahoma
# DEFAULT_CONFERENCE=SEC
